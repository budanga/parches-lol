     "partTitle": null,
     "spellKey": null,
     "kind": "text",
     "attribute": null,
     "before": null,
     "after": null,
     "text": "Corregimos varios errores que causaban que Yunara infligiera más o menos daño con efectos al impacto.",
     "id": "5b35fcfd3830",
